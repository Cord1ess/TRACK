# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Captured traffic tiles. Regenerable in about 13 minutes with
#   cd data-collection && python collector/capture.py --name <name>
# and they are Google map content, so they stay out of version control.
data-collection/captures/*
!data-collection/captures/.gitkeep

# Everything the pipeline derives: road graph, decoded weights, reports.
# Rebuild with: cd algorithms && python pipeline.py
algorithms/output/*
!algorithms/output/.gitkeep

# Editor / OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/

# The road graph is committed once, gzipped (OpenStreetMap data, 5 MB), so the
# collection workflow never has to query Overpass. Rebuild and re-gzip it when
# the road network or the bbox changes.
!algorithms/output/graph/
algorithms/output/graph/*
!algorithms/output/graph/dhaka.json.gz

# The static site build_site.py produces for GitHub Pages
site/
week1/